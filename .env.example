# ClinOR v0.3 — local-first inference. Copy to .env and run from this repo.
# A local model never needs OPENAI_API_KEY or internet for generation.
CLINOR_LLM_PROVIDER=ollama
CLINOR_LLM_DEPLOYMENT=local
CLINOR_LLM_MODEL=qwen2.5:3b
CLINOR_LLM_BASE_URL=http://127.0.0.1:11434
CLINOR_LLM_TIMEOUT=90
# If a local OpenAI-compatible server does not support JSON mode, set prompt_only.
# CLINOR_LLM_JSON_MODE=prompt_only

# --- LM Studio or llama.cpp (alternative): ---
# CLINOR_LLM_PROVIDER=openai_compatible
# CLINOR_LLM_DEPLOYMENT=local
# CLINOR_LLM_MODEL=<model loaded on your local server>
# CLINOR_LLM_BASE_URL=http://127.0.0.1:1234/v1

# --- Cloud OpenAI-compatible API (alternative, opt-in only): ---
# CLINOR_LLM_PROVIDER=openai_compatible
# CLINOR_LLM_DEPLOYMENT=cloud
# CLINOR_LLM_MODEL=<model identifier>
# CLINOR_LLM_BASE_URL=https://api.openai.com/v1
# CLINOR_LLM_API_KEY=<your private server-side key>
# CLINOR_ALLOW_CLOUD_LLM=1
# Cloud processing also requires explicit per-request consent_cloud_llm=true.

# Additional trusted hostnames for a LAN-based local model (optional):
# CLINOR_LLM_TRUSTED_HOSTS=192.168.1.5

# Medical literature discovery uses external services; the user must explicitly consent.
# Optional broader publisher website discovery:
BRAVE_SEARCH_API_KEY=

# Optional OpenAI model-operated web search, separate from the LLM backend:
OPENAI_WEB_SEARCH=0
OPENAI_API_KEY=
OPENAI_WEB_MODEL=gpt-4.1-mini
